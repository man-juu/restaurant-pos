{
  "name": "restaurant-pos-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/check-bundle.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit:deps": "npm audit --audit-level=high",
    "e2e": "playwright test",
    "api:generate": "openapi-typescript src/lib/api/tenant.openapi.json -o src/lib/api/tenant.d.ts && openapi-typescript src/lib/api/admin.openapi.json -o src/lib/api/admin.d.ts && prettier --write 'src/lib/api/*.d.ts'"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@tanstack/react-query": "5.104.0",
    "clsx": "2.1.1",
    "i18next": "26.4.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.89.0",
    "react-i18next": "17.0.16",
    "react-router": "8.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "eslint-plugin-sonarjs": "4.2.2",
    "globals": "17.13.0",
    "jsdom": "29.1.1",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.2",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.0",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.0.3"
  }
}

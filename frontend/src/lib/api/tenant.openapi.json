{
  "components": {
    "schemas": {
      "Capabilities": {
        "properties": {
          "all_outlets": {
            "title": "All Outlets",
            "type": "boolean"
          },
          "modules": {
            "items": {
              "type": "string"
            },
            "title": "Modules",
            "type": "array"
          },
          "nav": {
            "items": {
              "type": "string"
            },
            "title": "Nav",
            "type": "array"
          },
          "outlet_ids": {
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "title": "Outlet Ids",
            "type": "array"
          },
          "permissions": {
            "items": {
              "type": "string"
            },
            "title": "Permissions",
            "type": "array"
          },
          "subscription": {
            "$ref": "#/components/schemas/SubscriptionBanner"
          },
          "tenant_id": {
            "format": "uuid",
            "title": "Tenant Id",
            "type": "string"
          }
        },
        "required": [
          "tenant_id",
          "permissions",
          "all_outlets",
          "outlet_ids",
          "modules",
          "subscription",
          "nav"
        ],
        "title": "Capabilities",
        "type": "object"
      },
      "CodeRequest": {
        "properties": {
          "code": {
            "maxLength": 20,
            "minLength": 6,
            "title": "Code",
            "type": "string"
          }
        },
        "required": ["code"],
        "title": "CodeRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "InvitationAccept": {
        "properties": {
          "name": {
            "anyOf": [
              {
                "maxLength": 200,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "password": {
            "maxLength": 1024,
            "minLength": 1,
            "title": "Password",
            "type": "string"
          },
          "token": {
            "maxLength": 200,
            "minLength": 20,
            "title": "Token",
            "type": "string"
          }
        },
        "required": ["token", "password"],
        "title": "InvitationAccept",
        "type": "object"
      },
      "InvitationCreate": {
        "properties": {
          "email": {
            "maxLength": 254,
            "minLength": 3,
            "pattern": "^[^@\\s]+@[^@\\s]+$",
            "title": "Email",
            "type": "string"
          },
          "role_id": {
            "format": "uuid",
            "title": "Role Id",
            "type": "string"
          }
        },
        "required": ["email", "role_id"],
        "title": "InvitationCreate",
        "type": "object"
      },
      "InvitationOut": {
        "properties": {
          "email": {
            "title": "Email",
            "type": "string"
          },
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          }
        },
        "required": ["id", "email", "expires_at"],
        "title": "InvitationOut",
        "type": "object"
      },
      "LoginRequest": {
        "properties": {
          "email": {
            "maxLength": 254,
            "minLength": 3,
            "pattern": "^[^@\\s]+@[^@\\s]+$",
            "title": "Email",
            "type": "string"
          },
          "password": {
            "maxLength": 1024,
            "minLength": 1,
            "title": "Password",
            "type": "string"
          }
        },
        "required": ["email", "password"],
        "title": "LoginRequest",
        "type": "object"
      },
      "MfaSetupOut": {
        "properties": {
          "otpauth_uri": {
            "title": "Otpauth Uri",
            "type": "string"
          },
          "secret": {
            "title": "Secret",
            "type": "string"
          }
        },
        "required": ["secret", "otpauth_uri"],
        "title": "MfaSetupOut",
        "type": "object"
      },
      "OutletOut": {
        "properties": {
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "is_active": {
            "title": "Is Active",
            "type": "boolean"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "timezone": {
            "title": "Timezone",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": ["id", "name", "type", "timezone", "is_active"],
        "title": "OutletOut",
        "type": "object"
      },
      "PasswordResetConfirm": {
        "properties": {
          "new_password": {
            "maxLength": 1024,
            "minLength": 1,
            "title": "New Password",
            "type": "string"
          },
          "token": {
            "maxLength": 200,
            "minLength": 20,
            "title": "Token",
            "type": "string"
          }
        },
        "required": ["token", "new_password"],
        "title": "PasswordResetConfirm",
        "type": "object"
      },
      "PasswordResetRequest": {
        "properties": {
          "email": {
            "maxLength": 254,
            "minLength": 3,
            "pattern": "^[^@\\s]+@[^@\\s]+$",
            "title": "Email",
            "type": "string"
          }
        },
        "required": ["email"],
        "title": "PasswordResetRequest",
        "type": "object"
      },
      "RecoveryCodesOut": {
        "properties": {
          "recovery_codes": {
            "items": {
              "type": "string"
            },
            "title": "Recovery Codes",
            "type": "array"
          }
        },
        "required": ["recovery_codes"],
        "title": "RecoveryCodesOut",
        "type": "object"
      },
      "SessionInfo": {
        "properties": {
          "active_tenant_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Active Tenant Id"
          },
          "csrf_token": {
            "title": "Csrf Token",
            "type": "string"
          },
          "mfa_state": {
            "title": "Mfa State",
            "type": "string"
          },
          "tenants": {
            "items": {
              "$ref": "#/components/schemas/TenantOption"
            },
            "title": "Tenants",
            "type": "array"
          },
          "user": {
            "$ref": "#/components/schemas/UserOut"
          }
        },
        "required": ["user", "tenants", "active_tenant_id", "csrf_token", "mfa_state"],
        "title": "SessionInfo",
        "type": "object"
      },
      "SessionOut": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "current": {
            "title": "Current",
            "type": "boolean"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "ip": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ip"
          },
          "last_seen_at": {
            "format": "date-time",
            "title": "Last Seen At",
            "type": "string"
          },
          "user_agent": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "User Agent"
          }
        },
        "required": ["id", "created_at", "last_seen_at", "ip", "user_agent", "current"],
        "title": "SessionOut",
        "type": "object"
      },
      "SubscriptionBanner": {
        "properties": {
          "days_left": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Days Left"
          },
          "state": {
            "title": "State",
            "type": "string"
          }
        },
        "required": ["state", "days_left"],
        "title": "SubscriptionBanner",
        "type": "object"
      },
      "SwitchTenantRequest": {
        "properties": {
          "tenant_id": {
            "format": "uuid",
            "title": "Tenant Id",
            "type": "string"
          }
        },
        "required": ["tenant_id"],
        "title": "SwitchTenantRequest",
        "type": "object"
      },
      "TenantOption": {
        "properties": {
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": ["id", "name"],
        "title": "TenantOption",
        "type": "object"
      },
      "UserOut": {
        "properties": {
          "email": {
            "title": "Email",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "locale": {
            "title": "Locale",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": ["id", "email", "name", "locale"],
        "title": "UserOut",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": ["loc", "msg", "type"],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Restaurant POS API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/auth/invitations/accept": {
      "post": {
        "description": "New email: creates the account with the given password. Existing account: the\npassword must match it (proves the invitee owns that account). Then sign in normally.",
        "operationId": "accept_invitation_api_v1_auth_invitations_accept_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InvitationAccept"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Accept Invitation",
        "tags": ["auth"]
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "operationId": "login_api_v1_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionInfo"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Login",
        "tags": ["auth"]
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "operationId": "logout_api_v1_auth_logout_post",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        },
        "summary": "Logout",
        "tags": ["auth"]
      }
    },
    "/api/v1/auth/mfa/confirm": {
      "post": {
        "description": "Finish enrolment with a first code from the app; returns recovery codes once.",
        "operationId": "mfa_confirm_api_v1_auth_mfa_confirm_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CodeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecoveryCodesOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Mfa Confirm",
        "tags": ["auth"]
      }
    },
    "/api/v1/auth/mfa/setup": {
      "post": {
        "description": "Start (or restart) enrolment. Allowed when fully signed in or when enrolment is\nrequired; not while a code is still owed for an existing setup.",
        "operationId": "mfa_setup_api_v1_auth_mfa_setup_post",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MfaSetupOut"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Mfa Setup",
        "tags": ["auth"]
      }
    },
    "/api/v1/auth/mfa/verify": {
      "post": {
        "description": "Second sign-in step: a TOTP code, or a one-time recovery code.",
        "operationId": "mfa_verify_api_v1_auth_mfa_verify_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CodeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionInfo"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Mfa Verify",
        "tags": ["auth"]
      }
    },
    "/api/v1/auth/password-reset/confirm": {
      "post": {
        "description": "Single use; sets the new password and signs the user out everywhere. 2FA still\napplies at the next sign-in, so a stolen mailbox alone cannot take over an owner.",
        "operationId": "confirm_password_reset_api_v1_auth_password_reset_confirm_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PasswordResetConfirm"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Confirm Password Reset",
        "tags": ["auth"]
      }
    },
    "/api/v1/auth/password-reset/request": {
      "post": {
        "description": "Always 202, whether or not the email has an account (no account enumeration).",
        "operationId": "request_password_reset_api_v1_auth_password_reset_request_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PasswordResetRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Request Password Reset",
        "tags": ["auth"]
      }
    },
    "/api/v1/auth/session": {
      "get": {
        "operationId": "current_session_api_v1_auth_session_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionInfo"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Current Session",
        "tags": ["auth"]
      }
    },
    "/api/v1/auth/sessions": {
      "get": {
        "description": "FR-IDN-007: the user's active sessions, newest activity first.",
        "operationId": "my_sessions_api_v1_auth_sessions_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/SessionOut"
                  },
                  "title": "Response My Sessions Api V1 Auth Sessions Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "My Sessions",
        "tags": ["auth"]
      }
    },
    "/api/v1/auth/sessions/{session_id}": {
      "delete": {
        "description": "FR-IDN-007: revoke one of your own sessions (404 for anyone else's).",
        "operationId": "revoke_session_api_v1_auth_sessions__session_id__delete",
        "parameters": [
          {
            "in": "path",
            "name": "session_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Session Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Revoke Session",
        "tags": ["auth"]
      }
    },
    "/api/v1/auth/switch-tenant": {
      "post": {
        "description": "FR-IDN-005. The requested tenant is only a choice: it is checked against the user's\nmemberships. The session is rotated (new token and CSRF token) because the privileges\nchange, which defeats session fixation.",
        "operationId": "switch_tenant_api_v1_auth_switch_tenant_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SwitchTenantRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionInfo"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Switch Tenant",
        "tags": ["auth"]
      }
    },
    "/api/v1/invitations": {
      "post": {
        "description": "FR-IDN-006: invite a person by email (single use, expiring link).",
        "operationId": "create_invitation_api_v1_invitations_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InvitationCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvitationOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create Invitation",
        "tags": ["invitations"]
      }
    },
    "/api/v1/me/capabilities": {
      "get": {
        "description": "What the UI may show. Convenience only: every route re-checks on the server.",
        "operationId": "capabilities_api_v1_me_capabilities_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Capabilities"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Capabilities",
        "tags": ["tenant"]
      }
    },
    "/api/v1/outlets": {
      "get": {
        "operationId": "list_outlets_api_v1_outlets_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/OutletOut"
                  },
                  "title": "Response List Outlets Api V1 Outlets Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Outlets",
        "tags": ["tenant"]
      }
    },
    "/api/v1/outlets/{outlet_id}": {
      "get": {
        "description": "Another tenant's outlet is invisible (RLS); one outside the caller's scope is 404 too.",
        "operationId": "get_outlet_api_v1_outlets__outlet_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "outlet_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Outlet Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OutletOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Outlet",
        "tags": ["tenant"]
      }
    },
    "/health": {
      "get": {
        "description": "Liveness plus database status (NFR-010). 503 lets uptime checks and Docker see an outage.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": ["health"]
      }
    }
  }
}

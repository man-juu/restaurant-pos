# LF everywhere, also on Windows checkouts (core.autocrlf=true would write CRLF): code runs and
# is formatted inside Linux containers, shell shebangs fail with CRLF ("/bin/sh^M"), and
# Prettier and ruff expect LF.
* text=auto eol=lf
*.png binary
*.jpg binary
*.webp binary
*.ico binary
*.woff2 binary

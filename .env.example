# Copy to .env for local overrides. Never commit .env. These are development-only values.
POSTGRES_DB=pos
POSTGRES_USER=pos_owner
POSTGRES_PASSWORD=dev-only-password
# Login roles created on first database start (infra/db/init). The API uses pos_app.
APP_DB_PASSWORD=dev-only-app-password
READONLY_DB_PASSWORD=dev-only-readonly-password

# API (see backend/app/core/config.py). DATABASE_URL is set by compose for local development.
ENVIRONMENT=dev
LOG_LEVEL=INFO

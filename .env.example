# Copy to .env for local overrides. Never commit .env. These are development-only values.
POSTGRES_DB=pos
POSTGRES_USER=pos_owner
POSTGRES_PASSWORD=dev-only-password
# Login roles created on first database start (infra/db/init). The API uses pos_app.
APP_DB_PASSWORD=dev-only-app-password
READONLY_DB_PASSWORD=dev-only-readonly-password
# Platform admin app database role (separate from the tenant API role).
ADMIN_DB_PASSWORD=dev-only-admin-password

# API (see backend/app/core/config.py). DATABASE_URL is set by compose for local development.
ENVIRONMENT=dev
LOG_LEVEL=INFO

# 32 random bytes, base64 (python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())").
# Encrypts 2FA secrets. Empty uses a public dev-only key; required in staging and production.
SECRET_ENCRYPTION_KEY=
# Base URL used in emailed invitation and password-reset links.
APP_BASE_URL=http://localhost:5173

# Free AI images (ADR-022). Leave empty to keep the feature off. Use a Cloudflare account on the
# Workers FREE plan (no card) and an API token limited to "Workers AI: Read" (docs/runbooks/ai-images.md).
AI_CF_ACCOUNT_ID=
AI_CF_API_TOKEN=
